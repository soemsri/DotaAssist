{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotaAssist",
  "version": "1.0.0",
  "identifier": "com.dotaassist.desktop",
  "mainBinaryName": "dota-assist",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:3001 https://api.opendota.com https://translate.google.com",
        "media-src": "'self' asset: blob: data: https://translate.google.com https://*.google.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:3001 http://localhost:1420 ws://localhost:1420 https://api.opendota.com https://translate.google.com",
        "media-src": "'self' asset: blob: data: https://translate.google.com https://*.google.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "DotaAssist Overlay & Strategy Assistant",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
