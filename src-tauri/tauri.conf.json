{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "DotaAssist",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true,
        "setAlwaysOnTop": true,
        "setIgnoreCursorEvents": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.dotaassist.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "DotaAssist Overlay & Strategy Assistant",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": false
      }
    ]
  }
}
